# Copier ce fichier en .env et remplir les valeurs.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# En production : https://learny.example.bf
DJANGO_CSRF_TRUSTED_ORIGINS=

# Vide = SQLite en local. En production (o2switch) :
# DATABASE_URL=postgres://utilisateur:motdepasse@localhost:5432/learny
DATABASE_URL=

# Clé Gemini (Google AI Studio). Sans clé, Learny répond par un message de démonstration.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

LEARNY_QUOTA_JOUR=30
# Date du BEPC pour le compte à rebours, au format AAAA-MM-JJ (vide pour le masquer).
LEARNY_DATE_BEPC=
LEARNY_AIDE_WHATSAPP=+226 77 53 44 19
